diff --git a/src/ompl/CMakeLists.txt b/src/ompl/CMakeLists.txt
--- a/src/ompl/CMakeLists.txt
+++ b/src/ompl/CMakeLists.txt
@@ -35,7 +35,24 @@
 
 # build the library
 if(MSVC)
+    # Keep the existing static planner library, but share process-wide RNG and
+    # logging state across its consumers. Exporting all of OMPL exceeds MSVC's
+    # 65535-export limit because of its template instantiations.
+    set(OMPL_RUNTIME_SOURCES
+        "${CMAKE_CURRENT_SOURCE_DIR}/util/src/RandomNumbers.cpp"
+        "${CMAKE_CURRENT_SOURCE_DIR}/util/src/Console.cpp")
+    list(REMOVE_ITEM OMPL_SOURCE_CODE ${OMPL_RUNTIME_SOURCES})
+    add_library(ompl_runtime SHARED ${OMPL_RUNTIME_SOURCES})
+    set_target_properties(ompl_runtime PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS ON)
+    target_link_libraries(ompl_runtime PRIVATE Eigen3::Eigen Boost::boost
+        "$<$<BOOL:${Threads_FOUND}>:Threads::Threads>")
+    install(TARGETS ompl_runtime EXPORT omplExport
+        RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+        ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+        LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+        COMPONENT ompl)
     add_library(ompl STATIC ${OMPL_SOURCE_CODE})
+    target_link_libraries(ompl PUBLIC ompl_runtime)
 else()
     add_library(ompl SHARED ${OMPL_SOURCE_CODE})
 endif()
