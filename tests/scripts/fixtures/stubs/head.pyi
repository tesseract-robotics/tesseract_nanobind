from collections.abc import Mapping, Sequence
import enum
import os
from typing import overload

import tesseract_robotics.tesseract_common._tesseract_common


class Mode(enum.Enum):
    A = 0

    B = 1

class Robot:
    def __init__(self, name: str) -> None: ...

    @overload
    def setState(self, joints: Mapping[str, float]) -> None: ...

    @overload
    def setState(self, floating_joints: Mapping[str, tesseract_robotics.tesseract_common._tesseract_common.Isometry3d]) -> None: ...

    def place(self, pose: tesseract_robotics.tesseract_common._tesseract_common.Isometry3d) -> None: ...

    def locate(self, locator: tesseract_robotics.tesseract_common._tesseract_common.ResourceLocator) -> None: ...

    def frame(self, pose: tesseract_robotics.tesseract_common._tesseract_common.Isometry3d) -> None: ...

    def rename(self, new_name: str = 'x') -> None: ...

    def resize(self, n: float) -> None: ...

    def connect(self, from: str) -> None: ...

    def __eq__(self, arg: Robot, /) -> bool: ...

    @property
    def payload(self) -> float: ...

    @payload.setter
    def payload(self, arg: float, /) -> None: ...

    @staticmethod
    def make(name: str) -> Robot: ...

    CONFIG_KEY: str = ...

    def _private(self, extra: int) -> None: ...

class RobotError(Exception):
    pass

def helper(x: float) -> float: ...

def helper2(x: Sequence[str]) -> None: ...
