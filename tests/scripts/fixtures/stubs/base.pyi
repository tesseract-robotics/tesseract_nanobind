from collections.abc import Mapping, Sequence
import enum
import os

import tesseract_robotics.tesseract_common._tesseract_common


class Mode(enum.Enum):
    A = 0

class Robot:
    def __init__(self, name: str) -> None: ...

    def setState(self, joints: Mapping[str, float]) -> None: ...

    def place(self, pose: "Transform<double, 3, 1, 0>") -> None: ...

    def locate(self, locator: "tesseract::common::ResourceLocator") -> None: ...

