from collections.abc import Iterator
from typing import overload

class ThingPoly:
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, impl: Square) -> None: ...
    def asSquare(self) -> Square: ...
    def isSquare(self) -> bool: ...

class Square:
    def __init__(self) -> None: ...
    def __copy__(self) -> Square: ...
    def __deepcopy__(self, memo: dict) -> Square: ...
    def __eq__(self, arg: Square, /) -> bool: ...

class Circle:
    def __init__(self) -> None: ...

class Box:
    def __init__(self) -> None: ...
    @overload
    def put(self, thing: ThingPoly) -> None: ...
    @overload
    def put(self, thing: Square) -> None: ...
    def getThing(self) -> ThingPoly: ...
    def setThing(self, thing: ThingPoly) -> None: ...

class Things:
    def __init__(self) -> None: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[int]: ...
    def push_back(self, x: int) -> None: ...

class View:
    def __init__(self, box: Box) -> None: ...

class Lonely:
    def __init__(self, name: str) -> None: ...

class Shelf:
    def __init__(self) -> None: ...
    @overload
    def place(self, thing: ThingPoly) -> None: ...
    @overload
    def place(self, name: str) -> None: ...
