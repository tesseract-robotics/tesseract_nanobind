from typing import overload

class Loader:
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, config: str) -> None: ...

class Profile:
    def __init__(self) -> None: ...

class Orphan:
    def __init__(self) -> None: ...

class BaseProfile:
    def __init__(self) -> None: ...
    @staticmethod
    def from_yaml(config: str) -> BaseProfile: ...

class DerivedProfile(BaseProfile):
    def __init__(self) -> None: ...

class Configurator:
    def __init__(self) -> None: ...
    def getType(self) -> int: ...

class Hooks:
    def __init__(self) -> None: ...

class PluginFactory:
    def __init__(self) -> None: ...

class Box:
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, u: float) -> None: ...

class Holder:
    def __init__(self) -> None: ...
