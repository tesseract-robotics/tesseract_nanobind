import enum

class Status(enum.Enum):
    RUNNING = 0

    QP_SOLVE_FAILED = 1

    NLP_CONVERGED = 2

class Shift:
    def __init__(self) -> None: ...
    def __iadd__(self, arg: float, /) -> Shift: ...
    def __isub__(self, arg: float, /) -> Shift: ...

class Engine:
    def __init__(self) -> None: ...
    def warmStart(self, shift: Shift) -> bool: ...
    def tune(self, n: int) -> bool: ...
