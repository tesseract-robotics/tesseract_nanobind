from typing import overload

class Tile:
    def __init__(self) -> None: ...

class Disc:
    def __init__(self) -> None: ...
    def __eq__(self, arg: Disc, /) -> bool: ...

class Hexagon:
    def __init__(self) -> None: ...
    def __eq__(self, arg: Hexagon, /) -> bool: ...
    def __ne__(self, arg: Hexagon, /) -> bool: ...
    def sides(self) -> int: ...
    @property
    def area(self) -> float: ...

class Concealed:
    def __init__(self) -> None: ...

class Exposer:
    def __init__(self) -> None: ...
    def __eq__(self, arg: Exposer, /) -> bool: ...
    def __ne__(self, arg: Exposer, /) -> bool: ...
    def sides(self) -> int: ...

class Sprinter:
    def go(self) -> None: ...
    @overload
    def laps(self) -> int: ...
    @overload
    def laps(self, scale: float) -> int: ...  # Python-only overload: one deviation, on Sprinter

class SlowSprinter:
    def __init__(self) -> None: ...
    def go(self) -> None: ...

class DeepSprinter(Sprinter):
    def __init__(self) -> None: ...
    def depth(self) -> int: ...

class Relay(Sprinter):
    def __init__(self) -> None: ...
    def go(self) -> None: ...
    @overload
    def laps(self) -> int: ...
    @overload
    def laps(self, scale: float) -> int: ...

class Courier:
    def __init__(self) -> None: ...
