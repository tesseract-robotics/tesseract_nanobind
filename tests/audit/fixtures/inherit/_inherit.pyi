from typing import overload

class Square:
    def __init__(self) -> None: ...

class Circle:
    def __init__(self) -> None: ...
    def __eq__(self, arg: Circle, /) -> bool: ...

class Hexagon:
    def __init__(self) -> None: ...
    def __eq__(self, arg: Hexagon, /) -> bool: ...
    def __ne__(self, arg: Hexagon, /) -> bool: ...
    def sides(self) -> int: ...
    @property
    def area(self) -> float: ...

class Hidden:
    def __init__(self) -> None: ...

class Runner:
    def go(self) -> None: ...
    @overload
    def laps(self) -> int: ...
    @overload
    def laps(self, scale: float) -> int: ...  # Python-only overload: one deviation, on Runner

class SlowRunner:
    def __init__(self) -> None: ...
    def go(self) -> None: ...

class DeepRunner(Runner):
    def __init__(self) -> None: ...
    def depth(self) -> int: ...

class Relay(Runner):
    def __init__(self) -> None: ...
    def go(self) -> None: ...
    @overload
    def laps(self) -> int: ...
    @overload
    def laps(self, scale: float) -> int: ...

class Loner(Runner):
    def __init__(self) -> None: ...
