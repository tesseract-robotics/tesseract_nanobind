import enum
from collections.abc import Iterator
from typing import Annotated, overload

from numpy.typing import NDArray

import fixture_missing._fixture_missing
import fixture_remote._fixture_remote

class Plain:
    def __init__(self) -> None: ...
    @property
    def x(self) -> int: ...
    @x.setter
    def x(self, arg: int, /) -> None: ...

class Widget:
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, size: int) -> None: ...
    def size(self) -> int:
        """Docstring trap: "tesseract::fixture::NotAType" is prose, not an annotation."""
    def __eq__(self, other: Widget) -> bool: ...
    __hash__: None = None  # value-equality-unhashable: next to a bound __eq__
    def __bool__(self) -> bool: ...
    def __repr__(self) -> str: ...  # presentation-dunder (M12)
    def owner(self) -> "tesseract::fixture::Owner": ...
    def widget_samples(self) -> Annotated[NDArray, dict(shape=(None,), order="C")]: ...
    def widget_grow(self) -> None: ...
    @property
    def count(self) -> int: ...
    @count.setter
    def count(self, arg: int, /) -> None: ...

class Gadget:
    def __init__(self) -> None: ...
    def __len__(self) -> int: ...  # C++ Gadget has no size(): still a deviation
    __hash__: None = None  # no bound __eq__: still a deviation

class Bag:
    def __init__(self) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, i: int) -> int: ...
    def __setitem__(self, i: int, value: int) -> None: ...
    def __iter__(self) -> Iterator[int]: ...
    def __str__(self) -> str: ...
    def __mul__(self, factor: int) -> Bag: ...

class Record:
    def __init__(self, id: int) -> None: ...

class Buffer:
    def __init__(self, url: str, bytes: bytes, parent: int = 0) -> None: ...

class Runner:
    def go(self) -> None: ...
    def __call__(self, n: int) -> bool: ...

class FastRunner(Runner):
    def __init__(self) -> None: ...

class RemoteRunner(fixture_remote._fixture_remote.Runner):
    def __init__(self) -> None: ...

class LostRunner(fixture_missing._fixture_missing.Runner):
    def __init__(self) -> None: ...

class Color(enum.Enum):
    RED = 0

    GREEN = 1

Color_RED: Color = Color.RED

class Level(enum.Enum):
    LEVEL_LOW = 0

    LEVEL_HIGH = 1

LEVEL_LOW: Level = Level.LEVEL_LOW

def scale(value: int, factor: float = 1.0) -> int: ...
@overload
def area(w: int) -> int: ...
@overload
def area(w: int, h: int) -> int: ...
def collect(runner: Base, n: int) -> tuple[bool, list[int]]: ...
def describe(n: int) -> str: ...
def scale_twice(value: int) -> int: ...
def flatten() -> list[int]: ...
def fill(n: int) -> NDArray: ...
def shift(qs: NDArray, n: int) -> None: ...
def norm(m: NDArray) -> float: ...
def trace(m: NDArray) -> float: ...
