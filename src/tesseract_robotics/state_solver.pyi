"""tesseract_state_solver Python bindings"""

from collections.abc import Mapping, Sequence
from typing import Annotated, overload

import numpy
from numpy.typing import NDArray

import tesseract_robotics.common._common
import tesseract_robotics.scene_graph._scene_graph


class SceneState:
    def __init__(self) -> None: ...

    @property
    def joints(self) -> dict[tesseract_robotics.common._common.JointId, float]: ...

    @joints.setter
    def joints(self, arg: Mapping[tesseract_robotics.common._common.JointId, float] | Mapping[str, float], /) -> None: ...

    @property
    def floating_joints(self) -> dict[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d]: ...

    @floating_joints.setter
    def floating_joints(self, arg: Mapping[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d] | Mapping[str, tesseract_robotics.common._common.Isometry3d], /) -> None: ...

    @property
    def link_transforms(self) -> dict[tesseract_robotics.common._common.LinkId, tesseract_robotics.common._common.Isometry3d]: ...

    @link_transforms.setter
    def link_transforms(self, arg: Mapping[tesseract_robotics.common._common.LinkId, tesseract_robotics.common._common.Isometry3d] | Mapping[str, tesseract_robotics.common._common.Isometry3d], /) -> None: ...

    @property
    def joint_transforms(self) -> dict[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d]: ...

    @joint_transforms.setter
    def joint_transforms(self, arg: Mapping[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d] | Mapping[str, tesseract_robotics.common._common.Isometry3d], /) -> None: ...

    def getJointValues(self, joint_ids: Sequence[tesseract_robotics.common._common.JointId | str]) -> Annotated[NDArray[numpy.float64], dict(shape=(None,), order='C')]: ...

    def getFloatingJointValues(self, joint_ids: Sequence[tesseract_robotics.common._common.JointId | str]) -> dict[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d]: ...

    def __eq__(self, arg: SceneState, /) -> bool: ...

    def __ne__(self, arg: SceneState, /) -> bool: ...

    __hash__: None = None

class StateSolver:
    @overload
    def setState(self, joint_values: Annotated[NDArray[numpy.float64], dict(shape=(None,), writable=False)] | Sequence[float], floating_joint_values: Mapping[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d] | Mapping[str, tesseract_robotics.common._common.Isometry3d] = {}) -> None: ...

    @overload
    def setState(self, joint_values: Mapping[tesseract_robotics.common._common.JointId, float] | Mapping[str, float], floating_joint_values: Mapping[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d] | Mapping[str, tesseract_robotics.common._common.Isometry3d] = {}) -> None: ...

    @overload
    def setState(self, joint_ids: Sequence[tesseract_robotics.common._common.JointId | str], joint_values: Annotated[NDArray[numpy.float64], dict(shape=(None,), writable=False)] | Sequence[float], floating_joint_values: Mapping[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d] | Mapping[str, tesseract_robotics.common._common.Isometry3d] = {}) -> None: ...

    @overload
    def setState(self, floating_joint_values: Mapping[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d] | Mapping[str, tesseract_robotics.common._common.Isometry3d]) -> None: ...

    def setStateByMap(self, joint_values: Mapping[tesseract_robotics.common._common.JointId, float] | Mapping[str, float], floating_joint_values: Mapping[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d] | Mapping[str, tesseract_robotics.common._common.Isometry3d] = {}) -> None: ...

    def setStateByNamesAndValues(self, joint_ids: Sequence[tesseract_robotics.common._common.JointId | str], joint_values: Annotated[NDArray[numpy.float64], dict(shape=(None,), writable=False)] | Sequence[float], floating_joint_values: Mapping[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d] | Mapping[str, tesseract_robotics.common._common.Isometry3d] = {}) -> None: ...

    @overload
    def getState(self) -> SceneState: ...

    @overload
    def getState(self, joint_values: Annotated[NDArray[numpy.float64], dict(shape=(None,), writable=False)] | Sequence[float], floating_joint_values: Mapping[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d] | Mapping[str, tesseract_robotics.common._common.Isometry3d] = {}) -> SceneState: ...

    @overload
    def getState(self, joint_values: Mapping[tesseract_robotics.common._common.JointId, float] | Mapping[str, float], floating_joint_values: Mapping[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d] | Mapping[str, tesseract_robotics.common._common.Isometry3d] = {}) -> SceneState: ...

    @overload
    def getState(self, joint_ids: Sequence[tesseract_robotics.common._common.JointId | str], joint_values: Annotated[NDArray[numpy.float64], dict(shape=(None,), writable=False)] | Sequence[float], floating_joint_values: Mapping[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d] | Mapping[str, tesseract_robotics.common._common.Isometry3d] = {}) -> SceneState: ...

    @overload
    def getState(self, floating_joint_values: Mapping[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d] | Mapping[str, tesseract_robotics.common._common.Isometry3d]) -> SceneState: ...

    @overload
    def getLinkTransforms(self) -> list[tesseract_robotics.common._common.Isometry3d]: ...

    @overload
    def getLinkTransforms(self, joint_ids: Sequence[tesseract_robotics.common._common.JointId | str], joint_values: Annotated[NDArray[numpy.float64], dict(shape=(None,), writable=False)] | Sequence[float], floating_joint_values: Mapping[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d] | Mapping[str, tesseract_robotics.common._common.Isometry3d] = {}) -> dict[tesseract_robotics.common._common.LinkId, tesseract_robotics.common._common.Isometry3d]: ...

    def getRandomState(self) -> SceneState: ...

    @overload
    def getJacobian(self, joint_values: Annotated[NDArray[numpy.float64], dict(shape=(None,), writable=False)] | Sequence[float], link_id: tesseract_robotics.common._common.LinkId | str, floating_joint_values: Mapping[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d] | Mapping[str, tesseract_robotics.common._common.Isometry3d] = {}) -> Annotated[NDArray[numpy.float64], dict(shape=(None, None), order='F')]: ...

    @overload
    def getJacobian(self, joint_ids: Sequence[tesseract_robotics.common._common.JointId | str], joint_values: Annotated[NDArray[numpy.float64], dict(shape=(None,), writable=False)] | Sequence[float], link_id: tesseract_robotics.common._common.LinkId | str, floating_joint_values: Mapping[tesseract_robotics.common._common.JointId, tesseract_robotics.common._common.Isometry3d] | Mapping[str, tesseract_robotics.common._common.Isometry3d] = {}) -> Annotated[NDArray[numpy.float64], dict(shape=(None, None), order='F')]: ...

    def getJointIds(self) -> list[tesseract_robotics.common._common.JointId]: ...

    def getFloatingJointIds(self) -> list[tesseract_robotics.common._common.JointId]: ...

    def getActiveJointIds(self) -> list[tesseract_robotics.common._common.JointId]: ...

    def getBaseLinkId(self) -> tesseract_robotics.common._common.LinkId: ...

    def getLinkIds(self) -> list[tesseract_robotics.common._common.LinkId]: ...

    def getActiveLinkIds(self) -> list[tesseract_robotics.common._common.LinkId]: ...

    def getStaticLinkIds(self) -> list[tesseract_robotics.common._common.LinkId]: ...

    def isActiveLinkId(self, link_id: tesseract_robotics.common._common.LinkId | str) -> bool: ...

    def hasLinkId(self, link_id: tesseract_robotics.common._common.LinkId | str) -> bool: ...

    def getLinkTransform(self, link_id: tesseract_robotics.common._common.LinkId | str) -> tesseract_robotics.common._common.Isometry3d: ...

    def getRelativeLinkTransform(self, from_link_id: tesseract_robotics.common._common.LinkId | str, to_link_id: tesseract_robotics.common._common.LinkId | str) -> tesseract_robotics.common._common.Isometry3d: ...

    def getLimits(self) -> tesseract_robotics.common._common.KinematicLimits: ...

    def clone(self) -> StateSolver: ...

class MutableStateSolver(StateSolver):
    def setRevision(self, revision: int) -> None: ...

    def getRevision(self) -> int: ...

    def addLink(self, link: tesseract_robotics.scene_graph._scene_graph.Link, joint: tesseract_robotics.scene_graph._scene_graph.Joint) -> bool: ...

    def moveLink(self, joint: tesseract_robotics.scene_graph._scene_graph.Joint) -> bool: ...

    def removeLink(self, name: tesseract_robotics.common._common.LinkId | str) -> bool: ...

    def replaceJoint(self, joint: tesseract_robotics.scene_graph._scene_graph.Joint) -> bool: ...

    def removeJoint(self, name: tesseract_robotics.common._common.JointId | str) -> bool: ...

    def moveJoint(self, name: tesseract_robotics.common._common.JointId | str, parent_link: tesseract_robotics.common._common.LinkId | str) -> bool: ...

    def changeJointOrigin(self, name: tesseract_robotics.common._common.JointId | str, new_origin: tesseract_robotics.common._common.Isometry3d) -> bool: ...

    def changeJointPositionLimits(self, name: tesseract_robotics.common._common.JointId | str, lower: float, upper: float) -> bool: ...

    def changeJointVelocityLimits(self, name: tesseract_robotics.common._common.JointId | str, limit: float) -> bool: ...

    def changeJointAccelerationLimits(self, name: tesseract_robotics.common._common.JointId | str, limit: float) -> bool: ...

    def changeJointJerkLimits(self, name: tesseract_robotics.common._common.JointId | str, limit: float) -> bool: ...

    def insertSceneGraph(self, scene_graph: tesseract_robotics.scene_graph._scene_graph.SceneGraph, joint: tesseract_robotics.scene_graph._scene_graph.Joint, prefix: str = '') -> bool: ...

class KDLStateSolver(StateSolver):
    """
    State solver on a KDL tree. Floating joint values are ignored, and setState / getState with only floating_joint_values raise RuntimeError (upstream: not supported).
    """

    def __init__(self, scene_graph: tesseract_robotics.scene_graph._scene_graph.SceneGraph) -> None: ...

    def clone(self) -> StateSolver: ...

class OFKTStateSolver(MutableStateSolver):
    @overload
    def __init__(self, scene_graph: tesseract_robotics.scene_graph._scene_graph.SceneGraph) -> None: ...

    @overload
    def __init__(self, root_link_id: tesseract_robotics.common._common.LinkId | str) -> None: ...

    def clone(self) -> StateSolver: ...
