# Upstream sources for the wheel build (.github/workflows/wheels.yml). tesseract,
# tesseract_planning and trajopt are the `nanobind-0.36` integration branches on the jf---
# forks: upstream master plus our open upstream PRs, so a release does not wait on review.
# src/tesseract_robotics/build_identity.py records these SHAs; keep them in step
# (tests/test_build_identity.py checks).
- git:
    local-name: ros_industrial_cmake_boilerplate
    uri: https://github.com/ros-industrial/ros_industrial_cmake_boilerplate.git
    version: 0.7.4
- git:
    local-name: tesseract
    # master a9c22066 + tesseract-robotics/tesseract#1396
    uri: https://github.com/jf---/tesseract.git
    version: 4cf644d704bd8961c7cdaf193f72488fa501f5c0
- git:
    local-name: tesseract_planning
    # master a6483823 + tesseract-robotics/tesseract_planning#789, #792, #794
    uri: https://github.com/jf---/tesseract_planning.git
    version: 4e27d94b160f757e064dbad2a5277657cd33bbf8
- git:
    local-name: trajopt
    # master 963baf7d + tesseract-robotics/trajopt#628 (the bindings call the constructors and
    # calcJacobianBlock it defines) and #629
    uri: https://github.com/jf---/trajopt.git
    version: 98b85d559e9fc7cb60a4dbfeb6d3baa177c94df5
- git:
    local-name: descartes_light
    uri: https://github.com/swri-robotics/descartes_light.git
    version: 0.4.10
- git:
    local-name: opw_kinematics
    uri: https://github.com/Jmeyer1292/opw_kinematics.git
    version: 0.5.3
- git:
    local-name: ruckig
    uri: https://github.com/Levi-Armstrong/ruckig.git
    version: cpack-v0.9.2
- git:
    local-name: boost_plugin_loader
    uri: https://github.com/tesseract-robotics/boost_plugin_loader.git
    version: 0.5.0
